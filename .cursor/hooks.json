{
  "version": 1,
  "hooks": {
    "postToolUseFailure": [
      {
        "command": "python .cursor/hooks/ascendc_debug_hook.py postToolUseFailure",
        "timeout": 15
      }
    ],
    "afterAgentThought": [
      {
        "command": "python .cursor/hooks/ascendc_debug_hook.py afterAgentThought",
        "timeout": 15
      }
    ],
    "subagentStop": [
      {
        "command": "python .cursor/hooks/ascendc_debug_hook.py subagentStop",
        "timeout": 60,
        "loop_limit": 2
      }
    ],
    "sessionEnd": [
      {
        "command": "python .cursor/hooks/ascendc_debug_hook.py sessionEnd",
        "timeout": 60
      }
    ]
  }
}
