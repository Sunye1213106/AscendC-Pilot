{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Understand Operator candidate fact batch",
  "type": "object",
  "required": ["version", "task", "target", "items", "relations", "unresolved"],
  "additionalProperties": false,
  "properties": {
    "version": {"const": 2},
    "task": {
      "type": "object",
      "required": ["run_id", "stage", "owner", "task_id"],
      "additionalProperties": false,
      "properties": {
        "run_id": {"type": "string"},
        "stage": {"enum": ["step1", "step2", "step3"]},
        "owner": {"type": "string"},
        "task_id": {"type": "string"}
      }
    },
    "target": {
      "type": "object",
      "required": ["path"],
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string", "pattern": "^facts/.+\\.yaml$"},
        "section": {"type": "string", "minLength": 1}
      }
    },
    "items": {"type": "array", "items": {"$ref": "#/$defs/item"}},
    "relations": {"type": "array", "items": {"$ref": "#/$defs/relation"}},
    "unresolved": {"type": "array", "items": {"$ref": "#/$defs/unresolved"}}
  },
  "$defs": {
    "span": {
      "type": "object",
      "required": ["start_line", "end_line"],
      "additionalProperties": false,
      "properties": {
        "start_line": {"type": "integer", "minimum": 1},
        "end_line": {"type": "integer", "minimum": 1}
      }
    },
    "location": {
      "type": "object",
      "required": ["file", "symbol", "start_line", "end_line", "anchor_kind"],
      "additionalProperties": false,
      "properties": {
        "file": {"type": "string"},
        "symbol": {"type": "string"},
        "start_line": {"type": "integer", "minimum": 1},
        "end_line": {"type": "integer", "minimum": 1},
        "anchor_kind": {"type": "string"}
      }
    },
    "reference": {
      "oneOf": [
        {
          "type": "object",
          "required": ["ref_type", "local_id"],
          "additionalProperties": false,
          "properties": {
            "ref_type": {"const": "local"},
            "local_id": {"type": "string", "minLength": 1}
          }
        },
        {
          "type": "object",
          "required": ["ref_type", "kind", "identity"],
          "additionalProperties": false,
          "properties": {
            "ref_type": {"const": "entity"},
            "kind": {"type": "string", "minLength": 1},
            "identity": {"type": "object"}
          }
        },
        {
          "type": "object",
          "required": ["ref_type", "kind", "qualified_symbol"],
          "additionalProperties": false,
          "properties": {
            "ref_type": {"const": "symbol"},
            "kind": {"type": "string", "minLength": 1},
            "qualified_symbol": {"type": "string", "minLength": 1},
            "signature": {"type": "string"}
          }
        }
      ]
    },
    "item": {
      "type": "object",
      "required": ["local_id", "kind", "identity", "fields", "source_locations"],
      "additionalProperties": false,
      "properties": {
        "local_id": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "name": {"type": "string"},
        "identity": {"type": "object"},
        "fields": {"type": "object"},
        "source_locations": {"type": "array", "items": {"$ref": "#/$defs/location"}}
      }
    },
    "relation": {
      "type": "object",
      "required": ["type", "source", "target", "fields", "source_locations"],
      "additionalProperties": false,
      "properties": {
        "type": {"type": "string"},
        "source": {"$ref": "#/$defs/reference"},
        "target": {"$ref": "#/$defs/reference"},
        "fields": {"type": "object"},
        "source_locations": {"type": "array", "items": {"$ref": "#/$defs/location"}}
      }
    },
    "unresolved": {
      "type": "object",
      "required": ["local_id", "category", "description", "related_refs", "source_locations"],
      "additionalProperties": false,
      "properties": {
        "local_id": {"type": "string"},
        "category": {"type": "string"},
        "description": {"type": "string"},
        "related_refs": {"type": "array", "items": {"$ref": "#/$defs/reference"}},
        "source_locations": {"type": "array", "items": {"$ref": "#/$defs/location"}}
      }
    }
  }
}
