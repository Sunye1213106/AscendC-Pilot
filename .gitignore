.claude/
.opencode/
# Local-only eval oracles (do not commit)
.tmp-oracle/

# Cached clang bundles / derivation runs (keep replay corpus locally; never commit)
.probe_cache/

# Host runtime trees are composed at install time (see install.ps1)
generated/

# Extracted CANN toolkit (scripts/cann_extract.py --dest _cann/pkg)
_cann/

# Python cache and test artifacts
__pycache__/
*.py[cod]
.pytest_cache/
**/.pytest_cache/
# pytest --basetemp dirs. These held full UO run products (YAML, SQLite), which
# file discovery and scope closure would otherwise pick up as if they were source.
.pytest-tmp/
.pytest_tmp/
.pytest_tmp*/
_pytest_tmp*/
**/.pytest-tmp/
**/.pytest_tmp*/
**/_pytest_tmp*/
**/.tmp-pytest/
**/.tmp_pytest/
# One-off local probes. Nothing here is a reusable entry point.
.pytmp/

# Root / scratch one-off logs / local init dumps (never commit)
_*.log
_*.err
_*.out

# Local run products / obligation dumps / UO exports (never commit)
*.bundle
artifacts/
real-results/
_tmp*/
*.uo
!pilot/tests/fixtures/uo/
!pilot/tests/fixtures/uo/**
*.sqlite
*.sqlite3

# Packaging/build metadata
*.egg-info/
build/
dist/

# Local environments
.venv/
venv/
env/

# Operator-local agent products
.ascendc-agent/
.ascendc-pilot/
.understand-operator/
.testcase-generator/

# Editor/system files
.idea/
.vscode/
.DS_Store
Thumbs.db

